# URL pública del sitio, sin slash final. Déjala vacía hasta conectar el dominio.
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_CLARITY_PROJECT_ID=

# Credenciales privadas de Mercado Pago (sólo servidor).
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=

# Credenciales privadas de Supabase (sólo servidor; nunca usar NEXT_PUBLIC_).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Notificaciones administrativas de pedidos (solo servidor)
RESEND_API_KEY=
ORDER_NOTIFICATION_EMAIL=
RESEND_FROM_EMAIL=
DISPATCH_ADMIN_PASSWORD=

# This storefront does not require environment variables to run locally.

# Número de WhatsApp en formato internacional, sin +, espacios ni guiones.
NEXT_PUBLIC_WHATSAPP_NUMBER=
